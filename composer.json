{
    "name": "rafaelbucard/oficina2.0",
    "description": "Sistema de gestao de orcamentos para oficina (carros e motos) - MVC em PHP 8.3 com PostgreSQL.",
    "type": "project",
    "require": {
        "php": ">=8.3",
        "ext-pdo": "*",
        "ext-pdo_pgsql": "*",
        "ext-mbstring": "*",
        "dompdf/dompdf": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/helpers.php"
        ]
    },
    "config": {
        "optimize-autoloader": true
    }
}
